{
    "client": "openai",
    "model": "google/gemma-4-31b-it",
    "model-key-env": "OPEN_ROUTER_API",
    "model-base-url": "https://openrouter.ai/api/v1",
    "model-provider": {
        "order": ["crusoe"],
        "allow_fallbacks": false
    },
    "model-provider-fallbacks": ["novita", "friendli"],
    "provider-fallback": {
        "waits-per-provider": 10,
        "retry-primary-after-s": 900
    },
    "model-costs": { "input": 0.14, "output": 0.4 },
    "embeddings-client": "openai",
    "embeddings": "nomic-embed-text",
    "embeddings-key": "ollama",
    "embeddings-base-url": "http://localhost:11434/v1",
    "embeddings-costs": { "input": 0.0, "output": 0.0 },
    "experiment-name": "openrouter-llama31-8b",
    "cost-upperbound": 0.5,
    "decision-backend": "llm",
    "decision": {
        "noul-threshold": 0.5,
        "on-error": "failsafe"
    },
    "jev": {
        "model": "jev-latest",
        "base-url": "https://api.typesafe.ai/v1",
        "api-key-env": "TYPESAFE_API_KEY",
        "api-key": "<JEV-API-KEY>",
        "timeout": 30.0,
        "max-retries": 3,
        "costs": { "input": 0.042, "output": 0.0 }
    },
    "llm-trace": {
        "enabled": true,
        "dir": "../../logs/llm_trace",
        "head-chars": 200
    },
    "domain-guard": {
        "enabled": true
    },
    "json-no-fence": {
        "enabled": true
    },
    "lenient-parser": {
        "enabled": true
    },
    "model-timeout": 120,
    "rate-limit": {
        "attempts": 40,
        "base-delay": 2.0,
        "max-delay": 120.0
    },
    "run": {
        "seed": 20260922
    }
}
