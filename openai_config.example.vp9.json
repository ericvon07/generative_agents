{
    "client": "openai",
    "model": "google/gemma-4-31b-it",
    "model-key-env": "OPEN_ROUTER_API",
    "model-base-url": "https://openrouter.ai/api/v1",
    "model-provider": {
        "order": [
            "friendli"
        ],
        "allow_fallbacks": false
    },
    "model-provider-fallbacks": [
        "novita",
        "parasail",
        "crusoe"
    ],
    "_model-provider-note": "016-IP VP-B: the declared list is four, friendli -> novita -> parasail -> crusoe (the author, 2026-10-03). The health gate picks the pin on the day, the same for both arms; the others stay in order as fallbacks. A switch inside the four keeps the run valid.",
    "provider-fallback": {
        "waits-per-provider": 10,
        "retry-primary-after-s": 900
    },
    "model-costs": {
        "input": 0.14,
        "output": 0.4
    },
    "embeddings-client": "openai",
    "embeddings": "nomic-embed-text",
    "embeddings-key": "ollama",
    "embeddings-base-url": "http://localhost:11434/v1",
    "embeddings-costs": {
        "input": 0.0,
        "output": 0.0
    },
    "experiment-name": "vp9",
    "cost-upperbound": 20,
    "decision-backend": "llm",
    "decision": {
        "noul-threshold": 0.5,
        "on-error": "failsafe"
    },
    "jev": {
        "model": "jev-latest",
        "base-url": "https://api.typesafe.ai/v1",
        "api-key-env": "TYPESAFE_API_KEY",
        "api-key": "<JEV-API-KEY>",
        "timeout": 30.0,
        "max-retries": 6,
        "costs": {
            "input": 0.042,
            "output": 0.0
        },
        "retry-base-delay": 2.0,
        "retry-max-delay": 32.0
    },
    "llm-trace": {
        "enabled": true,
        "dir": "../../logs/llm_trace",
        "head-chars": 4000
    },
    "domain-guard": {
        "enabled": true
    },
    "json-no-fence": {
        "enabled": true
    },
    "lenient-parser": {
        "enabled": true
    },
    "model-timeout": 120,
    "rate-limit": {
        "attempts": 40,
        "base-delay": 2.0,
        "max-delay": 120.0
    },
    "run": {
        "seed": 20260922
    },
    "_decision-backend-note": "016-IP VP-B: both arms run this one file; the arm is chosen at launch by the DECISION_BACKEND environment variable (llm for vp9-llm, jev for vp9-jev).",
    "seed-history": "the_ville/agent_history_init_n25.csv",
    "_seed-history-note": "016-IP D13: the paper's seed memories (Park et al. 2023 \u00a73.1), loaded by the runner in a run's first stage when its origin is at step 0; rows of agents not in the simulation skipped. Each arm loads its own, so the importance of each seed memory is that arm's decision (the author, 2026-10-03)."
}
